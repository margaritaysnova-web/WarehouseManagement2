<Window x:Class="WarehouseApp.Views.Dialogs.WarehouseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Склад" 
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E2E"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" 
                   Text="Данные склада" 
                   FontSize="18" FontWeight="Bold" 
                   Foreground="#FF2196F3"
                   Margin="0,0,0,15"/>
        
        <StackPanel Grid.Row="1">
            <TextBlock Text="Наименование склада:" 
                       Foreground="White"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="NameTextBox" 
                     Width="300"
                     Background="#FF3D3D5C"
                     Foreground="White"
                     BorderBrush="#FF404060"/>
        </StackPanel>
        
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="Адрес склада:" 
                       Foreground="White"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="AddressTextBox" 
                     Width="300"
                     Background="#FF3D3D5C"
                     Foreground="White"
                     BorderBrush="#FF404060"/>
        </StackPanel>
        
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,15,0,0">
            <Button Content="Отмена" 
                    Background="#FF2D2D44"
                    Foreground="White"
                    Click="CancelButton_Click"
                    Width="100"
                    Height="35"/>
            <Button Content="Сохранить" 
                    Background="#FF4CAF50"
                    Foreground="White"
                    Click="SaveButton_Click"
                    Width="100"
                    Height="35"
                    Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>