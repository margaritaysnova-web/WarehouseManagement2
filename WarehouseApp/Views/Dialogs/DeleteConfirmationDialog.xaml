<Window x:Class="WarehouseApp.Views.Dialogs.DeleteConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение удаления" 
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E2E"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Подтверждение удаления" 
                   FontSize="18" FontWeight="Bold" 
                   Foreground="#FF2196F3"
                   Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" 
                   Text="Для подтверждения удаления введите название организации:"
                   Foreground="White" 
                   Margin="0,0,0,10"/>

        <TextBox Grid.Row="2" 
                 x:Name="ConfirmationTextBox" 
                 Width="300"
                 Background="#FF3D3D5C"
                 Foreground="White"
                 BorderBrush="#FF404060"/>

        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,15,0,0">
            <Button Content="Отмена" 
                    Background="#FF2D2D44"
                    Foreground="White"
                    Click="CancelButton_Click"
                    Width="100"
                    Height="35"/>
            <Button Content="Удалить" 
                    Background="#FFF44336"
                    Foreground="White"
                    Click="DeleteButton_Click"
                    Width="100"
                    Height="35"
                    Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>