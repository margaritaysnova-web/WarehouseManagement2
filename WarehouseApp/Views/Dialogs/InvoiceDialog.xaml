<Window x:Class="WarehouseApp.Views.Dialogs.InvoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Накладная" 
        Width="800" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E2E"
        ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   x:Name="TitleTextBlock"
                   Text="Накладная" 
                   FontSize="18" FontWeight="Bold" 
                   Foreground="#FF2196F3"
                   Margin="0,0,0,15"/>

        <!-- Информация о накладной -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Номер накладной:" Foreground="White" FontSize="12"/>
                <TextBlock x:Name="InvoiceNumberText" Foreground="#FF2196F3" FontSize="14" FontWeight="Bold"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Тип:" Foreground="White" FontSize="12"/>
                <TextBlock x:Name="InvoiceTypeText" Foreground="#FF4CAF50" FontSize="14" FontWeight="Bold"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Статус:" Foreground="White" FontSize="12"/>
                <TextBlock x:Name="StatusText" Foreground="#FFFF9800" FontSize="14" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <!-- Товары в накладной -->
        <DataGrid Grid.Row="2" 
                 x:Name="InvoiceItemsGrid"
                 AutoGenerateColumns="False"
                 Background="#FF35355A"
                 Margin="0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Артикул" 
                                   Binding="{Binding ProductArticle}" 
                                   Width="120"/>
                <DataGridTextColumn Header="Наименование" 
                                   Binding="{Binding ProductName}" 
                                   Width="200"/>
                <DataGridTextColumn Header="Количество" 
                                   Binding="{Binding Quantity}" 
                                   Width="100"/>
                <DataGridTextColumn Header="Цена" 
                                   Binding="{Binding Price, StringFormat='{}{0:N2} руб.'}" 
                                   Width="120"/>
                <DataGridTextColumn Header="Сумма" 
                                   Binding="{Binding TotalPrice, StringFormat='{}{0:N2} руб.'}" 
                                   Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Добавление товара в накладную -->
        <Grid Grid.Row="3" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ComboBox x:Name="ProductComboBox" 
                         Width="250" Height="30"
                         Background="#FF3D3D5C"
                         Foreground="White"/>
                <TextBox x:Name="QuantityTextBox" 
                         Width="80" Height="30"
                         Background="#FF3D3D5C"
                         Foreground="White"
                         Text="1"
                         Margin="10,0,0,0"/>
                <Button Content="+ Добавить" 
                        Background="#FF2196F3"
                        Foreground="White"
                        Click="AddItemButton_Click"
                        Width="100" Height="30"
                        Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Итог и кнопки -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" 
                   HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="TotalText" 
                      Text="Итого: 0,00 руб." 
                      Foreground="#FF4CAF50"
                      FontSize="16" FontWeight="Bold"
                      Margin="0,0,20,0"
                      VerticalAlignment="Center"/>
            <Button Content="Отмена" 
                    Background="#FF2D2D44"
                    Foreground="White"
                    Click="CancelButton_Click"
                    Width="100" Height="35"/>
            <Button Content="Провести накладную" 
                    Background="#FF4CAF50"
                    Foreground="White"
                    Click="ProcessButton_Click"
                    Width="150" Height="35"
                    Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>