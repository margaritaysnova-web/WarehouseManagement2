<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Основные цвета -->
    <Color x:Key="PrimaryColor">#FF2196F3</Color>
    <Color x:Key="DarkBackground">#FF1E1E2E</Color>
    <Color x:Key="CardBackground">#FF2D2D44</Color>
    <Color x:Key="TextColor">White</Color>
    <Color x:Key="AccentColor">#FF4CAF50</Color>
    <Color x:Key="DangerColor">#FFF44336</Color>
    <Color x:Key="WarningColor">#FFFF9800</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF2196F3"/>
    <SolidColorBrush x:Key="DarkBrush" Color="#FF1E1E2E"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FF2D2D44"/>
    <SolidColorBrush x:Key="TextBrush" Color="White"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4CAF50"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFF44336"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFF9800"/>

</ResourceDictionary>